{
  "theme": "auto",
  "model": "opus[1m]",
  "statusLine": { "type": "command", "command": "~/.local/bin/claude-statusline" },
  "permissions": { "defaultMode": "bypassPermissions" },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-state 0" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-state 1" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-state 1" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-state 0" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-state 0" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "~/.local/bin/claude-tmux-state unset" }] }]
  }
}
