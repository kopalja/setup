{
  "theme": "auto",
  "model": "opus[1m]",
  "permissions": { "defaultMode": "bypassPermissions" },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "[ -z \"$TMUX_PANE\" ] || tmux set-option -pt \"$TMUX_PANE\" @claude-working 0" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "[ -z \"$TMUX_PANE\" ] || tmux set-option -pt \"$TMUX_PANE\" @claude-working 1" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "[ -z \"$TMUX_PANE\" ] || tmux set-option -pt \"$TMUX_PANE\" @claude-working 1" }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "[ -z \"$TMUX_PANE\" ] || tmux set-option -pt \"$TMUX_PANE\" @claude-working 0" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "[ -z \"$TMUX_PANE\" ] || tmux set-option -pt \"$TMUX_PANE\" @claude-working 0" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "[ -z \"$TMUX_PANE\" ] || tmux set-option -put \"$TMUX_PANE\" @claude-working" }] }]
  }
}
