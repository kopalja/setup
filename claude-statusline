#!/bin/sh
# Claude Code status line: dir · git branch · model effort · context used.
# Reads the status JSON from stdin.
jq -r '(.workspace.current_dir // .cwd), .model.display_name, (.effort.level // ""),
    (.context_window.used_percentage // 0 | round)' | {
    read -r dir
    read -r model
    read -r effort
    read -r used
    branch=$(git --no-optional-locks -C "$dir" branch --show-current 2>/dev/null)
    case $dir in "$HOME" | "$HOME"/*) dir="~${dir#"$HOME"}" ;; esac
    e=$(printf '\033')
    # Gruvbox dark: green, blue, orange, purple, gray.
    green="$e[38;2;184;187;38m" blue="$e[38;2;131;165;152m" orange="$e[38;2;254;128;25m"
    purple="$e[38;2;211;134;155m" gray="$e[38;2;146;131;116m" reset="$e[0m"
    sep="$gray · $reset"
    printf '%s' "$green$dir$reset"
    [ -n "$branch" ] && printf '%s' "$sep$blue$branch$reset"
    printf '%s\n' "$sep$orange$model${effort:+ $effort}$reset$sep${purple}Context $used% used$reset"
}
