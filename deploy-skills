#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
BACKUP_DIR="${BACKUP_DIR:-$HOME/.setup-backups/$(date +%Y%m%d-%H%M%S)}"

if (($# == 0)); then
  set -- "$HOME/.codex/skills" "$HOME/.claude/skills"
fi

backup_skill() {
  local target="$1"

  if [ -e "$target" ] || [ -L "$target" ]; then
    mkdir -p "$BACKUP_DIR"
    cp -R "$target" "$BACKUP_DIR/"
    printf 'Backed up %s to %s/\n' "$target" "$BACKUP_DIR"
  fi
}

deploy_skill() {
  local source="$1"
  local target="$2"
  local temporary

  if [ -d "$target" ] && diff -qr "$source" "$target" >/dev/null; then
    printf 'Unchanged %s\n' "$target"
    return
  fi

  backup_skill "$target"
  mkdir -p "$(dirname "$target")"
  temporary="$(mktemp -d "$(dirname "$target")/.skill.tmp.XXXXXX")"
  if ! cp -R "$source" "$temporary/$(basename "$target")"; then
    rm -rf "$temporary"
    return 1
  fi
  rm -rf "$target"
  if ! mv -f "$temporary/$(basename "$target")" "$target"; then
    rm -rf "$temporary"
    return 1
  fi
  rmdir "$temporary"
  printf 'Installed %s\n' "$target"
}

found_skills=false
for skill in "$SCRIPT_DIR"/skills/*/; do
  [ -f "${skill}SKILL.md" ] || continue
  found_skills=true
  for destination in "$@"; do
    deploy_skill "$skill" "$destination/$(basename "$skill")"
  done
done

if [ "$found_skills" = false ]; then
  printf 'No skills found under %s/skills\n' "$SCRIPT_DIR"
fi
